Description: Retry swapped VA-API chroma plane formats after EGL import failure
 Firefox already swaps GR/RG chroma formats when EGL modifier enumeration says
 the advertised format is unsupported. Panfrost can enumerate linear GR1616
 but reject the actual eglCreateImage call with EGL_BAD_MATCH, so HEVC Main10
 VA-API decode falls back to software after its first frame.
 .
 Preserve the standards-correct GR1616 descriptor as the first choice. If the
 real image creation fails, retry the same existing RG/GR alternative once.
Author: Yi Ding <yi.s.ding@gmail.com>
Forwarded: not-yet
Last-Update: 2026-07-29

--- a/widget/gtk/DMABufSurface.cpp
+++ b/widget/gtk/DMABufSurface.cpp
@@ -2166,6 +2166,7 @@
   const auto& gle = gl::GLContextEGL::Cast(aGLContext);
   const auto& egl = gle->mEgl;
 
+  uint32_t swappedPlaneFormat = 0;
   if ((aPlane == 1) &&
       ((GetFOURCCFormat() == VA_FOURCC_NV12) ||
        (GetFOURCCFormat() == VA_FOURCC_P010) ||
@@ -2176,19 +2177,20 @@
                       mDrmFormats[aPlane] == DRM_FORMAT_RG1616);
     uint32_t wasGR = (mDrmFormats[aPlane] == DRM_FORMAT_GR88 ||
                       mDrmFormats[aPlane] == DRM_FORMAT_GR1616);
+    if (wasGR || wasRG) {
+      if (GetFOURCCFormat() == VA_FOURCC_NV12) {
+        swappedPlaneFormat = wasGR ? DRM_FORMAT_RG88 : DRM_FORMAT_GR88;
+      } else {
+        swappedPlaneFormat =
+            wasGR ? DRM_FORMAT_RG1616 : DRM_FORMAT_GR1616;
+      }
+    }
 
     EGLint modifierCount = 0;
     egl->mLib->fQueryDmaBufModifiersEXT(egl->mDisplay, mDrmFormats[aPlane], 0,
                                         nullptr, nullptr, &modifierCount);
-    if (modifierCount <= 0 && (wasGR || wasRG)) {
-      uint32_t swappedFormat = 0;
-      if (GetFOURCCFormat() == VA_FOURCC_NV12) {
-        swappedFormat = wasGR ? DRM_FORMAT_RG88 : DRM_FORMAT_GR88;
-      } else if (GetFOURCCFormat() == VA_FOURCC_P010 ||
-                 GetFOURCCFormat() == VA_FOURCC_P016) {
-        swappedFormat = wasGR ? DRM_FORMAT_RG1616 : DRM_FORMAT_GR1616;
-      }
-      mDrmFormats[aPlane] = static_cast<int>(swappedFormat);
+    if (modifierCount <= 0 && swappedPlaneFormat) {
+      mDrmFormats[aPlane] = static_cast<int>(swappedPlaneFormat);
 
       egl->mLib->fQueryDmaBufModifiersEXT(egl->mDisplay, mDrmFormats[aPlane], 0,
                                           nullptr, nullptr, &modifierCount);
@@ -2235,6 +2237,22 @@
       egl->fCreateImage(LOCAL_EGL_NO_CONTEXT, LOCAL_EGL_LINUX_DMA_BUF_EXT,
                         nullptr, attribs.Elements());
 
+  if (mEGLImage[aPlane] == LOCAL_EGL_NO_IMAGE && swappedPlaneFormat &&
+      mDrmFormats[aPlane] != static_cast<int>(swappedPlaneFormat)) {
+    EGLint firstError = egl->mLib->fGetError();
+    LOGDMABUF(
+        "  EGLImageKHR creation failed with advertised format, EGL error %s; "
+        "retrying swapped chroma format",
+        FormatEGLError(firstError).c_str());
+    mDrmFormats[aPlane] = static_cast<int>(swappedPlaneFormat);
+    MOZ_DIAGNOSTIC_ASSERT(
+        attribs[4] == LOCAL_EGL_LINUX_DRM_FOURCC_EXT);
